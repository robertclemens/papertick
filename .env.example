# ============================================================================
# PaperTick configuration
# Copy to .env and fill in. Never commit the real .env file.
# Every variable below maps to backend/app/config.py; unset values use the
# defaults shown here.
# ============================================================================

# --- Required secrets -------------------------------------------------------
# Postgres password for the bundled database container.
#   generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# Master application secret: signs JWTs (access/refresh/MFA/email tokens) and
# derives the encryption key that seals TOTP secrets at rest. Rotating it
# invalidates all sessions and enrolled TOTP secrets. Minimum 32 chars.
#   generate: openssl rand -hex 48
SECRET_KEY=CHANGE_ME_openssl_rand_hex_48

# --- Environment ------------------------------------------------------------
# development | production.
# production additionally REQUIRES email verification on signup and on email
# changes (see SMTP below); development skips verification.
ENV=development

# Set true when serving over HTTPS so auth cookies get the Secure flag.
COOKIE_SECURE=false

# Public URL of the web UI. Used for CORS, WebAuthn origin checks, and the
# links inside verification emails.
FRONTEND_ORIGIN=http://localhost:3000

# Host port docker-compose publishes the web UI on (container stays on 3000).
FRONTEND_PORT=3000

# --- Market data ------------------------------------------------------------
# auto     : chain = Polygon (if key) -> Alpaca (if keys) -> Yahoo -> synthetic
# polygon | alpaca | yahoo | synthetic : force a single provider
# Yahoo is the free default: near-real-time but unofficial, no SLA. Synthetic
# is a deterministic offline model (also supplies quotes when everything else
# is down in auto mode).
MARKET_DATA_PROVIDER=auto

# Optional paid sources for guaranteed real-time / exact data:
# Polygon.io API key (https://polygon.io — real-time where your plan allows).
POLYGON_API_KEY=
# Alpaca market-data keys (https://alpaca.markets).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET=

# --- Market emulation -------------------------------------------------------
# true  : NYSE calendar enforced — market orders queue outside 9:30-16:00 ET,
#         mutual funds fill at the daily closing NAV, options trade only while
#         the market is open (real-brokerage behavior).
# false : everything fills instantly at the latest price (sandbox mode).
ENFORCE_MARKET_HOURS=true

# --- Simulated trading costs ------------------------------------------------
# Flat commission per executed stock/fund order, in USD.
TRADE_FEE_USD=0.00
# Adverse slippage applied to live market orders, in basis points (2 = 0.02%).
SLIPPAGE_BPS=2
# Commission per option contract (0.65 matches typical brokerages).
OPTION_FEE_PER_CONTRACT=0.65
# Risk-free rate used by the Black-Scholes option pricing model.
RISK_FREE_RATE=0.045
# Days a deleted scenario stays recoverable before it is purged for good.
SCENARIO_RETENTION_DAYS=30

# Allow past-dated ("as of") trades. Off by default: a backdated fill rewrites
# balances and realized gains inside periods that already have statements, and
# lets an order be placed knowing how it turned out. Turn it on for market
# testing — any statement covering a backdated date is regenerated after the
# fill so the archive keeps matching the ledger.
ALLOW_BACKDATED_TRADES=false

# Settlement fund (VMFXX) 7-day SEC yield, annualized (0.0413 = 4.13%).
# Leave at 0 to use the built-in VMFXX rate history.
SETTLEMENT_YIELD_ANNUAL=0

# --- Sessions & login security ---------------------------------------------
# Access-token lifetime in seconds (short-lived JWT).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh-token lifetime in seconds (rotating; reuse revokes the family).
REFRESH_TOKEN_TTL_SECONDS=604800
# Failed logins per email before a temporary lockout, and the lockout length.
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_SECONDS=900

# --- Email (verification links) ---------------------------------------------
# Used when ENV=production for signup/email-change verification. If SMTP_HOST
# is empty, verification links are written to the backend log instead of sent
# (fine for development, useless in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PaperTick <no-reply@yourdomain.example>
SMTP_STARTTLS=true
# Lifetime of email verification links, in seconds (default 24h).
EMAIL_TOKEN_TTL_SECONDS=86400

# --- Passkeys (WebAuthn) ----------------------------------------------------
# Relying-party ID: defaults to the hostname of FRONTEND_ORIGIN. Set it only
# when serving the UI from multiple subdomains (use the registrable domain,
# e.g. example.com). NOTE: passkeys require a secure context — https, or
# http://localhost for development.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=PaperTick

# --- Optional demo account --------------------------------------------------
# Seeded once at startup only when DEMO_MODE=true and both values are set.
# Password must pass the normal policy (12+ chars, letters + digits).
DEMO_MODE=false
DEMO_EMAIL=
DEMO_PASSWORD=

# =============================================================================
#  PaperTick configuration
#
#  cp .env.example .env    and edit. The real .env is gitignored; keep it that way.
#
#  Only the three secrets below are required — everything after them shows its
#  built-in default, so a .env with just those secrets is a working config.
#  docker-compose.yml forwards all of this to the backend, worker and beat, so
#  this file is the only place normal changes go. The "why" behind the market
#  data and tax settings is in docs/, linked from the section headers.
# =============================================================================


# --- Secrets — required ------------------------------------------------------
# Use these generators as given. The two passwords are interpolated into
# connection URLs, so a value containing @ : / ? # or + makes a broken URL and a
# backend that never goes healthy — which rules out `openssl rand -base64`.
#
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
#   openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_32
#   openssl rand -hex 48
# Signs sessions and scenario exports, and derives the key that encrypts TOTP
# secrets. Changing it logs everyone out and breaks enrolled authenticator apps.
SECRET_KEY=CHANGE_ME_openssl_rand_hex_48


# =============================================================================
#  DEPLOYMENT
# =============================================================================

# development | production. production requires email verification to sign up
# or change an address, blocks unverified logins, answers signup on a known
# address neutrally (so the form can't enumerate accounts), runs new-device
# verification, and stops serving the API docs anonymously. It does NOT control
# anything HTTPS-related — that's the next three settings.
ENV=development

# true when you're behind TLS: marks auth cookies Secure and turns on HSTS.
COOKIE_SECURE=false

# Public origin of the UI: scheme, host and port, never a path. Drives CORS,
# the cross-origin check on writes, WebAuthn, and links in emails. Passkeys
# need a secure context, so outside localhost this has to be https.
FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated Host values this deployment answers to; empty disables the
# check. Fine to leave empty locally, worth setting in production.
#   e.g. papertick.example,www.papertick.example
ALLOWED_HOSTS=

# Serve from a sub-folder rather than a domain root: /papertick puts the UI at
# https://domain.example/papertick/. Compiled into the frontend build, so a
# change needs `up -d --build`. See docs/reverse-proxy.md.
BASE_PATH=

# Host port for the web UI (the container stays on 3000). The backend port is
# never published; the frontend proxies /api and /healthz to it internally.
FRONTEND_PORT=3000

# CIDRs of proxies whose X-Forwarded-For may be believed, e.g. 10.0.0.0/8.
# Empty = trust nothing and use the peer address. Leave it empty unless you
# control the proxy: the left-most entry is whatever the client sent, so
# trusting it lets a caller pick its own rate-limit bucket. Do NOT list the
# bundled frontend container — its rewrite forwards the client's header
# unchanged rather than appending what it saw.
TRUSTED_PROXY_CIDRS=


# =============================================================================
#  EMAIL
#  Required in production. With SMTP_HOST empty, verification links are written
#  to the backend log instead of sent — fine for a private demo, not for real
#  signups.
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Change the domain — most relays reject a From they aren't authorised for.
SMTP_FROM=PaperTick <no-reply@yourdomain.example>
# Lifetime of verification and email-change links (24h).
EMAIL_TOKEN_TTL_SECONDS=86400


# =============================================================================
#  MARKET DATA                                       docs/market-data.md
# =============================================================================

# auto | polygon | tiingo | alpaca | yahoo | nasdaq | synthetic
# auto chains Polygon -> Tiingo -> Alpaca -> Yahoo -> Nasdaq, skipping any
# whose keys aren't set. Yahoo is the free default: near-real-time, unofficial,
# no SLA.
#
# synthetic is never part of auto. It invents prices, and a fill is permanent —
# one made against a fabricated quote would sit in the ledger forever, looking
# exactly like a real trade. When every real provider is down, readers get the
# last cached price (labelled stale) and due orders are held, not filled. Set
# it explicitly for an offline sandbox.
MARKET_DATA_PROVIDER=auto

# Keyless backstop at the end of the chain. Equities and ETFs only, and that
# limit is the safety mechanism: its mutual-fund series isn't split-adjusted,
# so funds are never asked of it.
NASDAQ_FALLBACK=true

# Optional paid sources. Tiingo is the one to add first — the only paid vendor
# here carrying mutual-fund NAVs, with a free personal tier.
POLYGON_API_KEY=
TIINGO_API_TOKEN=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET=


# --- Caching and the upstream budget -----------------------------------------
# Nothing polls on its own: every upstream request is caused by data needed to
# execute something, or by someone looking at a page. An idle deployment makes
# zero provider requests.

# Redis cache lifetimes. Quotes are the hot path — every page showing a price
# reads through this — and are what stands between a busy dashboard and a
# rate-limit ban. Below 5 is refused.
QUOTE_CACHE_SECONDS=30
HISTORY_CACHE_SECONDS=3600
# Over a day on purpose, so repeat dividend reconciliations cost nothing.
DIVIDEND_CACHE_SECONDS=90000

# Outbound requests per minute, shared by api + worker + beat through one Redis
# bucket. When spent, callers serve the last known price or fail cleanly rather
# than queueing. 0 disables it.
MARKET_UPSTREAM_PER_MINUTE=120

# How often an open page re-prices while the market is open. The server derives
# the real cadence from the calendar: this while open, 10x for the four hours
# after the close while fund NAVs post, nothing while shut. Doesn't scale with
# viewers — one shared server cache. 0 turns it off; 1-14 is refused.
MARKET_REFRESH_SECONDS=60


# --- Price convention --------------------------------------------------------
# Prices must be split-adjusted and NOT dividend-adjusted. Vendors ship both and
# call both "the close" (VWELX on 2015-01-02: $39.16 vs $17.04), and since
# dividends are credited separately here, the wrong series counts every
# distribution twice. Each provider is measured against fixtures whose answers
# are permanent historical fact.
CONVENTION_PROBE=true
# How stale a verdict may be when a price becomes a permanent ledger row.
# Checking a cached verdict is free and happens on every fill; only re-measuring
# costs anything (~800ms), and this amortises it. 0 re-measures every fill.
CONVENTION_MAX_AGE_HOURS=24
# Drop a provider proven to be on the wrong convention. Bad prices are
# permanent; a missing provider only holds orders. Only a confident mismatch
# quarantines, never a failed fetch. See GET /api/v1/market/providers.
CONVENTION_QUARANTINE=true


# --- Waiting for prices ------------------------------------------------------
# Mutual funds are forward-priced: an order before 4:00 PM ET gets that day's
# NAV, but most funds don't publish until 5-8 PM. Fund orders wait while the
# worker retries. How often to re-ask for one fund/day, and when to give up:
NAV_POLL_INTERVAL_SECONDS=300
NAV_POLL_GIVE_UP_HOURS=30
# If our providers still can't price it after all that, an independent source
# is asked whether the NAV exists at all. If it does, the failure is ours and
# the order is held this many extra days instead of rejected. 0 disables it.
NAV_HOLD_MAX_DAYS=5
# How long a due order keeps retrying while every provider is unreachable.
# Synthetic prices are never substituted, so an outage holds rather than fills.
MARKET_DATA_GIVE_UP_HOURS=24


# =============================================================================
#  TRADING BEHAVIOUR
# =============================================================================

# true  : NYSE calendar enforced — market orders queue outside 9:30-16:00 ET,
#         funds fill at the closing NAV, options trade only while open.
# false : everything fills instantly at the latest price (sandbox).
ENFORCE_MARKET_HOURS=true

# Past-dated ("as of") trades are not set here. They're a per-scenario switch,
# so one track can backtest freely while another stays a clean record.

# What happens to recurring buys the worker slept through. true replays each
# missed run at the close printed on its own day, so the ledger ends up where
# it would have been. false fires one buy at today's price, losing both the
# missed contributions and the cost basis.
CATCHUP_MISSED_RUNS=true
# How far back one catch-up reaches, so restoring an old backup can't fire a
# year of trades in one tick.
MAX_CATCHUP_DAYS=30

# Days a deleted scenario stays recoverable before it's purged for good.
SCENARIO_RETENTION_DAYS=30


# =============================================================================
#  SIMULATED COSTS                                   docs/accounting.md
# =============================================================================

# Flat commission per executed stock/fund order, USD.
TRADE_FEE_USD=0.00
# Per option contract (0.65 matches typical brokerages).
OPTION_FEE_PER_CONTRACT=0.65

# variable : each fill draws from a triangular distribution over [MIN, BPS, MAX]
#            — most near the typical spread, a longer adverse tail, and negative
#            draws for the price improvement retail flow really gets. Seeded
#            from the order id, so replaying a backtest reproduces its fills.
# fixed    : SLIPPAGE_BPS adversely on every fill.
# Mutual funds are never slipped — NAV isn't a quote you can miss.
SLIPPAGE_MODEL=variable
# Basis points (2 = 0.02%). The mode under variable, the exact value under fixed.
SLIPPAGE_BPS=2
# Window ends. MIN may be negative: a fill better than the quote.
SLIPPAGE_BPS_MIN=-1
SLIPPAGE_BPS_MAX=6

# Risk-free rate for the Black-Scholes option model.
RISK_FREE_RATE=0.045
# Settlement fund (VMFXX) 7-day SEC yield, annualized (0.0413 = 4.13%).
# 0 uses the built-in VMFXX rate history.
SETTLEMENT_YIELD_ANNUAL=0


# =============================================================================
#  SESSIONS AND SIGN-IN                              docs/auth-and-security.md
# =============================================================================

# Access token lifetime, seconds (short-lived JWT).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime. Rotating; reuse revokes the whole family.
REFRESH_TOKEN_TTL_SECONDS=604800
# The half-authenticated token between password and MFA code.
MFA_TOKEN_TTL_SECONDS=300
# Failed logins per email before a temporary lockout, and how long it lasts.
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_SECONDS=900

# Passkeys. RP ID defaults to the hostname of FRONTEND_ORIGIN; set it only when
# serving from several subdomains, using the registrable domain (example.com).
WEBAUTHN_RP_ID=
# Shown in the browser or OS passkey prompt.
WEBAUTHN_RP_NAME=PaperTick

# New-device verification: the fallback second factor for accounts with neither
# a passkey nor an authenticator app. An unrecognised browser has to enter a
# code emailed to the account; verified browsers are remembered and revocable
# under Settings. Runs in production only whatever this says, or a development
# checkout with no SMTP relay would be impossible to log into.
DEVICE_VERIFICATION=true
DEVICE_TRUST_DAYS=30
# Lifetime of the emailed code. Five wrong guesses burn the challenge.
DEVICE_OTP_TTL_SECONDS=600


# =============================================================================
#  DEMO ACCOUNT
#  Seeded at startup when DEMO_MODE=true and both values are set. The password
#  must pass the normal policy (12+ chars, letters and digits). Local trial
#  only — leave it off in production.
# =============================================================================
DEMO_MODE=false
DEMO_EMAIL=
DEMO_PASSWORD=


# =============================================================================
#  CONNECTION STRINGS
#  For reference only. With the bundled stack, docker-compose builds these from
#  the passwords above and anything set here is ignored. They apply when a
#  backend process runs outside Compose — e.g. `uvicorn app.main:app` against a
#  local or managed database. The frontend's BACKEND_URL is likewise fixed to
#  http://backend:8000 in docker-compose.yml and is not read here.
# =============================================================================
# DATABASE_URL=postgresql+psycopg://papertick:papertick@localhost:5432/papertick
# REDIS_URL=redis://localhost:6379/0

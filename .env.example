# ============================================================================
# PaperTick configuration
#
# Copy to .env and fill in:   cp .env.example .env
# Never commit the real .env (it is in .gitignore).
#
# Layout:
#   1. Required for production — must be set before a public deployment.
#   2. Optional — every remaining setting, with its built-in default shown.
#
# Everything here except POSTGRES_PASSWORD, REDIS_PASSWORD and FRONTEND_PORT
# maps to a field in backend/app/config.py, and docker-compose.yml forwards all
# of them to the backend, worker and beat containers with matching defaults, so
# this file is the only place normal configuration changes need to be made.
# ============================================================================


# ############################################################################
# 1. REQUIRED FOR PRODUCTION
# ############################################################################

# --- Secrets ----------------------------------------------------------------
# All three are required for the stack to start at all, in any environment.
# Generate fresh, unique values per deployment — never reuse a development .env.

# Postgres password for the bundled database container.
#   generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# Password for the bundled Redis container. Redis holds WebAuthn challenges,
# login-lockout counters, rate-limit state and the market-price cache the
# trading engine reads — all of which are worth authenticating.
#   generate: openssl rand -base64 36
REDIS_PASSWORD=CHANGE_ME_openssl_rand_base64_36

# Master application secret: signs JWTs (access/refresh/MFA/email tokens),
# derives the encryption key that seals TOTP secrets at rest, and signs
# scenario exports so a hand-edited file cannot be imported. Rotating it
# invalidates all sessions, enrolled TOTP secrets and existing export files.
# Minimum 32 chars; the backend refuses to start on a weak or short value.
#   generate: openssl rand -hex 48
SECRET_KEY=CHANGE_ME_openssl_rand_hex_48

# --- Environment ------------------------------------------------------------
# development | production.
# production REQUIRES email verification on signup and on email changes (so
# SMTP below stops being optional), and serves the API docs, ReDoc and the
# OpenAPI spec only to an authenticated caller instead of anonymously.
ENV=development

# Set true when serving over HTTPS: adds the Secure flag to auth cookies and
# turns on HSTS on both services. Leave false for plain-HTTP localhost, where
# Secure cookies would simply never be stored.
COOKIE_SECURE=false

# Public origin of the web UI — scheme, host and port only, never a path (an
# Origin header has no path; put a sub-folder in BASE_PATH instead). Drives
# CORS, the cross-origin check on state-changing requests, WebAuthn origin
# checks, and the links inside verification emails. Passkeys need a secure
# context, so outside localhost development this must be https://.
FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated Host values this deployment answers to, e.g.
# "papertick.example,www.papertick.example". Empty disables the check, which is
# fine locally; set it in production so a spoofed Host cannot reach routing.
ALLOWED_HOSTS=

# --- Email (verification links) ---------------------------------------------
# Required in production: ENV=production makes email verification mandatory,
# and with SMTP_HOST empty the links are only written to the backend log
# instead of being sent — usable for a private demo, useless for real signups.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PaperTick <no-reply@yourdomain.example>
SMTP_STARTTLS=true


# ############################################################################
# 2. OPTIONAL — every value below has a working default
# ############################################################################

# --- Deployment shape -------------------------------------------------------
# Serve the app from a sub-folder of a shared domain instead of its own
# hostname: BASE_PATH=/papertick puts the UI at https://domain.example/papertick/
# and the API at https://domain.example/papertick/api/v1/... Empty (default) =
# domain root. The reverse proxy must pass the prefix through unchanged.
# Compiled into the frontend build, so a change needs `up -d --build`, not just
# a restart.
BASE_PATH=

# Host port docker-compose publishes the web UI on (the container stays on
# 3000). The backend port is deliberately never published — the frontend
# proxies /api and /healthz to it over the internal Docker network.
FRONTEND_PORT=3000

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For header may be
# believed, e.g. "10.0.0.0/8". Empty (the default) means trust nothing and use
# the peer address.
#
# Leave this EMPTY unless the app really is behind a proxy you control. The
# left-most X-Forwarded-For entry is whatever the client sent, so trusting the
# header from an arbitrary source lets a caller pick its own rate-limit bucket
# and rotate past every limit in the application.
#
# IMPORTANT — do NOT list the bundled `frontend` container here. Its Next.js
# rewrite forwards the client's X-Forwarded-For unchanged rather than appending
# the address it observed, so trusting it hands the bucket key straight back to
# the caller (measured: 14/14 signups past a 10/hour cap). Listing nothing is
# correct for the bundled stack; the cost is that unauthenticated endpoints
# share one bucket, which the per-account limits below cover.
#
# Behind a real ingress that APPENDS the observed address (nginx
# `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`, an ALB, or
# Cloudflare), list the ingress *and* frontend CIDRs: the backend walks the
# chain from the right past hops it trusts and stops at the first one the
# client could have forged.
TRUSTED_PROXY_CIDRS=

# --- Passkeys (WebAuthn) ----------------------------------------------------
# Relying-party ID: defaults to the hostname of FRONTEND_ORIGIN. Set it only
# when serving the UI from multiple subdomains (use the registrable domain,
# e.g. example.com). NOTE: passkeys require a secure context — https, or
# http://localhost for development.
WEBAUTHN_RP_ID=
# Name shown in the browser/OS passkey prompt.
WEBAUTHN_RP_NAME=PaperTick

# --- Market data ------------------------------------------------------------
# auto     : chain = Polygon (if key) -> Alpaca (if keys) -> Yahoo -> synthetic
# polygon | alpaca | yahoo | synthetic : force a single provider
# Yahoo is the free default: near-real-time but unofficial, no SLA. Synthetic
# is a deterministic offline model (also supplies quotes when everything else
# is down in auto mode). A failing source enters a 5-minute cool-down.
MARKET_DATA_PROVIDER=auto

# Optional paid sources for guaranteed real-time / exact data:
# Polygon.io API key (https://polygon.io — real-time where your plan allows).
POLYGON_API_KEY=
# Alpaca market-data keys (https://alpaca.markets).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET=

# --- Market emulation -------------------------------------------------------
# true  : NYSE calendar enforced — market orders queue outside 9:30-16:00 ET,
#         mutual funds fill at the daily closing NAV, options trade only while
#         the market is open (real-brokerage behavior).
# false : everything fills instantly at the latest price (sandbox mode).
ENFORCE_MARKET_HOURS=true

# Allow past-dated ("as of") trades. Off by default: a backdated fill rewrites
# balances and realized gains inside periods that already have statements, and
# lets an order be placed knowing how it turned out. Turn it on for market
# testing — any statement covering a backdated date is regenerated after the
# fill so the archive keeps matching the ledger.
ALLOW_BACKDATED_TRADES=false

# --- Simulated trading costs ------------------------------------------------
# Flat commission per executed stock/fund order, in USD.
TRADE_FEE_USD=0.00
# Adverse slippage applied to live market orders, in basis points (2 = 0.02%).
SLIPPAGE_BPS=2
# Commission per option contract (0.65 matches typical brokerages).
OPTION_FEE_PER_CONTRACT=0.65
# Risk-free rate used by the Black-Scholes option pricing model.
RISK_FREE_RATE=0.045
# Settlement fund (VMFXX) 7-day SEC yield, annualized (0.0413 = 4.13%).
# Leave at 0 to use the built-in VMFXX rate history.
SETTLEMENT_YIELD_ANNUAL=0
# Days a deleted scenario stays recoverable before it is purged for good.
SCENARIO_RETENTION_DAYS=30

# --- Sessions & login security ---------------------------------------------
# Access-token lifetime in seconds (short-lived JWT).
ACCESS_TOKEN_TTL_SECONDS=1200
# Refresh-token lifetime in seconds (rotating; reuse revokes the family).
REFRESH_TOKEN_TTL_SECONDS=604800
# How long the half-authenticated token issued between password and MFA code
# stays valid, in seconds.
MFA_TOKEN_TTL_SECONDS=300
# Failed logins per email before a temporary lockout, and the lockout length.
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_SECONDS=900
# Lifetime of email verification links, in seconds (default 24h).
EMAIL_TOKEN_TTL_SECONDS=86400

# --- Optional demo account --------------------------------------------------
# Seeded once at startup only when DEMO_MODE=true and both values are set.
# Password must pass the normal policy (12+ chars, letters + digits).
# Local trial only — leave off in production.
DEMO_MODE=false
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Connection strings (set for you by docker-compose) ---------------------
# Listed for completeness: with the bundled stack these are built from
# POSTGRES_PASSWORD / REDIS_PASSWORD in docker-compose.yml, and a value set
# here is ignored. They apply when the backend, worker or beat is run outside
# Compose — e.g. `uvicorn app.main:app` against a local or managed database.
# DATABASE_URL=postgresql+psycopg://papertick:papertick@localhost:5432/papertick
# REDIS_URL=redis://localhost:6379/0
#
# The frontend's BACKEND_URL is likewise fixed to http://backend:8000 in
# docker-compose.yml (build arg + runtime env) and is not read from here.
